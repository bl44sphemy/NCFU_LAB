#include <iostream>
#include <iomanip>
#include <cmath>

int main(){

    double a, b, h;
    
    std::cout << "Enter start of interval a: \n";
    std::cin >> a;

    std::cout << "Enter end of interval b: \n";
    std::cin >> b;

    std::cout << "Enter the interval step h: \n";
    std::cin >> h;

    if (a>b){
        std::cout << "ERROR: end must be above the start!";
        return 1;
    }
    if (h<=0){
        std::cout << "ERROR: step must be above 0!";
        return 1;
    }

    std::cout << "\n=================================" << std::endl;
    std::cout << " x       |   y = (x-2)^2" << std::endl;
    std::cout << "=================================" << std::endl;

    std::cout << std::fixed<<std::setprecision(4);

    for (double x=a; x<=b + 1e-9; x +=h){
        double y = pow((x-2), 2);
        std::cout << std::setw(8) << x << " | " << std::setw(12) << y <<std::endl;
    }

    std::cout << "=================================" << std::endl;

    return 0;

}
