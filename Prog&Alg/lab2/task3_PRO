#include <iostream>

int main(){
    int x1;
    int y1;

    std::cout << "Enter the value of the first variable: " << std::endl;
    std::cin >> x1;

    std::cout << "Enter the value of the second variable: " << std::endl;
    std::cin >> y1;

    double x2 = static_cast<double>(x1);
    double y2 = static_cast<double>(y1);

    std::cout << "Comparison of arithmetic operations INT and DOUBLE" << std::endl;

    std::cout << "1. Sum                INT: " << x1 + y1 << "     DOUBLE: " << x2 + y2 << std::endl;

    std::cout << "2. Difference         INT: " << x1 - y1 << "     DOUBLE: " << x2 - y2 << std::endl;

    std::cout << "3. Product            INT: " << x1 * y1 << "     DOUBLE: " << x2 * y2 << std::endl;

    std::cout << "4. Quotient           INT: " << x1 / y1 << "     DOUBLE: " << x2 / y2 << std::endl;

    return 0;
}
