#include <iostream>

//ВАРИАНТ 9

int main() {
    
    double width;
    double length;
    double height;
    double V;
    double Spov;

    std::cout << "Введите ширину параллелепипеда: " << std::endl;
    std::cin >> width;

    std::cout << "Введите длину параллелепипеда: "  << std::endl;
    std::cin >> length;

    std::cout << "Введите высоту параллелепипеда: " << std::endl;
    std::cin >> height;

    V = width * height * length;
    Spov = 2*(length*width) + ((length+width)*2)*height;

    std::cout << "Объем параллелепипеда: " << V << std::endl; 
    std::cout << "Площадь поверхности параллелепипеда: " << Spov << std::endl;

    return 0;
}
