#include <iostream>


int main() {
    
    double width;
    double length;
    double height;
    double V;
    double Spov;

    std::cout << "Enter the width of the parallelepiped: " << std::endl;
    std::cin >> width;

    std::cout << "Enter the length of the parallelepiped: "  << std::endl;
    std::cin >> length;

    std::cout << "Enter the height of the parallelepiped: " << std::endl;
    std::cin >> height;

    V = width * height * length;
    Spov = 2*(length*width) + ((length+width)*2)*height;

    std::cout << "The volume of a parallelepiped: " << V << std::endl; 
    std::cout << "The surface area of a parallelepiped: " << Spov << std::endl;

    return 0;
}
